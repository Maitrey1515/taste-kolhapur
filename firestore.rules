rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.owner_id);
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
    }

    match /restaurant_events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /review_replies/{replyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ownership_claims/{claimId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == request.resource.data.user_id || isAdmin());
    }
  }
}
